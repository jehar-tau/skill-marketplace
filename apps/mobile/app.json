{
  "expo": {
    "name": "Skill Marketplace",
    "slug": "skill-marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.skillmarket.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "skillmarket",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your area is used to find people near you. Your exact location is never shown to anyone."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F6B57"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "The microphone is used only while you hold the record button, to hear what you need or offer."
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Photos you pick are sent only to the chat you choose."
        }
      ],
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}